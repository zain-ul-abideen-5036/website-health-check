{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "fluid": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public/**,node_modules/**}",
      "excludeFiles": "{node_modules/@sentry/**,node_modules/sentry/**,node_modules/@opentelemetry/**,node_modules/@oxc-*/**,node_modules/**/*.d.ts,node_modules/**/*.map,node_modules/**/*.md}"
    }
  }
}
