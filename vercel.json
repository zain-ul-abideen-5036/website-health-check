{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "fluid": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public/**,node_modules/@sparticuz/chromium/bin/**,node_modules/lighthouse/**,node_modules/axe-core/**}"
    }
  }
}
